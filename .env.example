# Kalshi API Key ID (UUID from Account -> API Keys)
# Can reuse the same keys as kalshi-sports-bot
KALSHI_API_KEY=

# Path to the .key file Kalshi gave you when the key was created
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private.txt

# Set true only when you want real orders with --trade live
AUTO_TRADE_LIVE=false

BANKROLL=10

# Set to false if you see SSL CERTIFICATE_VERIFY_FAILED (common on Windows)
SSL_VERIFY=false

# Trading thresholds
MIN_CONFIDENCE_THRESHOLD=0.72
MIN_CONFIDENCE_FOR_TRADE=0.72
MAX_UNCERTAINTY_FOR_TRADE=0.45
MIN_EDGE_THRESHOLD=0.04
MIN_MARKET_IMPLIED_PROB=0.15
MAX_ORDERS_PER_CYCLE=1
MIN_ORDER_STAKE_USD=0.10

# How often to scan (seconds) — 45s works well for 15-min windows
REFRESH_INTERVAL_SECONDS=45

# Entry window: only bet when this many minutes remain before close
MIN_MINUTES_TO_CLOSE=3.0
MAX_MINUTES_TO_CLOSE=10.0

# Exit rules — hold to settlement avoids panic-selling at bad bids
HOLD_TO_SETTLEMENT=true
EXIT_EDGE_REVERSAL=0.03
EXIT_MIN_PROFIT_CENTS=5
EXIT_CONFIDENCE_DROP=0.15
EXIT_MAX_LOSS_CENTS=25
